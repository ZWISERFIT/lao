# LAO launch environment - EXAMPLE ONLY
#
# The real file is never committed. Keep it OUTSIDE this repository
# (this deployment uses ~/.config/lao/lao-launch.env, mode 600) and point
# the service unit at it with EnvironmentFile=.
#
# Fill in your own provider keys. Empty values below are intentional.

# Runtime basics required by the service unit
HOME=
LANG=
PATH=

# Provider keys. One key per agent, pattern: OC_DEEPSEEK_<AGENT>_API_KEY
# (agents in this deployment: baron ethan luna momo nova shuyu stella tristan zeus)
OC_DEEPSEEK_API_KEY=
OC_DEEPSEEK_TRISTAN_API_KEY=

# Auxiliary providers
OC_QWEN_API_KEY=
OC_TOKEN_PLAN_API_KEY=
OC_MEMORY_SEARCH_API_KEY=
NOVAROUTEAI_API_KEY=
